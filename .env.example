# ─────────────────────────────────────────────
# REALVIAN — Environment Variables
# Copy to .env and fill in. NEVER commit .env
# ─────────────────────────────────────────────

# ── Phase 0 (required now) ──
# Postgres with PostGIS extension enabled
DATABASE_URL=postgresql://user:password@localhost:5432/realvian

# Generate with: openssl rand -hex 32
AUTH_SECRET=

NEXT_PUBLIC_SITE_URL=https://realvian.co.uk

# ── Phase 1 (add when building payments / email / AI) ──
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
# ANTHROPIC_API_KEY=
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=   # only loads after cookie consent

# ── Phase 2+ ──
# REDIS_URL=
# CLOUDFLARE_R2_ACCESS_KEY=
# CLOUDFLARE_R2_SECRET_KEY=
# SENTRY_DSN=
